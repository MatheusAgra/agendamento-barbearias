{
  "name": "barber-platform-workspace",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["frontend"],
  "engines": { "node": ">=22.12.0", "npm": ">=10" },
  "scripts": {
    "dev:frontend": "npm run dev --workspace frontend",
    "build:frontend": "npm run build --workspace frontend",
    "check:frontend": "npm run check --workspace frontend",
    "spec": "openspec",
    "spec:init": "openspec init --tools codex",
    "spec:list": "openspec list",
    "spec:validate": "openspec validate --all --strict",
    "db:up": "docker compose up -d --wait database",
    "db:down": "docker compose down",
    "db:status": "docker compose ps"
  },
  "devDependencies": { "@fission-ai/openspec": "1.17.0" }
}
